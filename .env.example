# Copy this to .env and fill in real values.
# Vercel does not upload .env files. Add SECRET_KEY, DATABASE_URL, and any
# CUSTOM_DOMAIN value in the Vercel project Settings > Environment Variables.

DEBUG=False
SECRET_KEY=your-very-secret-key-here

# Neon PostgreSQL connection string (from neon.tech dashboard)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional: your Vercel custom domain (e.g. balajios.com)
CUSTOM_DOMAIN=
