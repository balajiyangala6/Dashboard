# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=balaji_os

DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret

# Optional: your Vercel custom domain (e.g. balajios.com)
CUSTOM_DOMAIN=

# After configuring MongoDB, create the first Admin interactively:
# python manage.py create_admin <username>
# Admin accounts can create User/Admin accounts in the Admin Console.
